<Application x:Class="CapyLulu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CapyLulu"
             ShutdownMode="OnMainWindowClose">
    <!-- 右键菜单的皮。放在 Application 一级而不是 MainWindow.xaml：菜单是独立的弹出
         窗口，隐式样式从这里往下覆盖最省事，以后哪个窗口加菜单都自动是同一副皮。
         颜色全部取自 Skin，和两个窗口共用一份调色板。 -->
    <Application.Resources>
        <!-- 菜单和子菜单共用这一副木框，画法和 Skin.Bevel 一样：外描边 + 木框带 +
             左上高光 + 右下阴影 + 羊皮纸底。写成模板而不是抄两遍，改一处两边都跟着变。 -->
        <ControlTemplate x:Key="MenuFrame" TargetType="ContentControl">
            <Border Padding="8"
                    Background="{x:Static local:Skin.WoodGrain}"
                    BorderBrush="{x:Static local:Skin.Outline}"
                    BorderThickness="4">
                <Border BorderBrush="{x:Static local:Skin.Highlight}" BorderThickness="4,4,0,0">
                    <Border Padding="0,4"
                            Background="{x:Static local:Skin.Parchment}"
                            BorderBrush="{x:Static local:Skin.Shadow}"
                            BorderThickness="0,0,4,4">
                        <ContentPresenter />
                    </Border>
                </Border>
            </Border>
        </ControlTemplate>

        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{x:Static local:Skin.Font}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{x:Static local:Skin.Ink}" />
            <!-- 星露谷没有软投影，去掉系统那层阴影，直角才立得住。 -->
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <ContentControl Focusable="False" Template="{StaticResource MenuFrame}">
                            <ItemsPresenter />
                        </ContentControl>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <!-- 一个模板覆盖菜单里的四种角色：叶子项、可勾选项、子菜单头、
                             禁用项，差别只是勾和箭头显不显示，不必按角色各写一份。 -->
                        <Border x:Name="_row"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="_check"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="{x:Static local:Skin.Accent}"
                                           Text="✔"
                                           Visibility="Collapsed" />
                                <ContentPresenter x:Name="_header"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                                <TextBlock x:Name="_arrow"
                                           Grid.Column="2"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="9"
                                           Foreground="{x:Static local:Skin.Muted}"
                                           Text="▶"
                                           Visibility="Collapsed" />
                                <Popup Focusable="False"
                                       HorizontalOffset="-6"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       Placement="Right"
                                       VerticalOffset="-8">
                                    <ContentControl Focusable="False" Template="{StaticResource MenuFrame}">
                                        <ItemsPresenter />
                                    </ContentControl>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="_arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="_check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- 选中的那一条像被拿起来的木牌：木色底配羊皮纸字。
                                 字色只改 _header，不改 MenuItem 自己：MenuItem 是个
                                 ItemsControl，字色落在它身上会顺着继承链漏进子菜单，
                                 于是羊皮纸底上写羊皮纸字，子菜单整片看不见。 -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="_row" Property="Background" Value="{x:Static local:Skin.WoodMid}" />
                                <Setter TargetName="_header" Property="TextElement.Foreground" Value="{x:Static local:Skin.Parchment}" />
                            </Trigger>
                            <!-- 放在高亮之后：唱歌时那几项是禁用的，鼠标扫过也不该亮起来。 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="_row" Property="Background" Value="Transparent" />
                                <Setter TargetName="_header" Property="TextElement.Foreground" Value="{x:Static local:Skin.Muted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分隔线是一道凹进去的缝：上暗下亮。菜单里的 Separator 走的是这个键，
             不是隐式样式，所以两条都留着，哪条生效都长一样。 -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Margin="12,5" BorderBrush="{x:Static local:Skin.Shadow}" BorderThickness="0,2,0,0">
                            <Border BorderBrush="{x:Static local:Skin.Highlight}" BorderThickness="0,2,0,0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}" TargetType="Separator" />
    </Application.Resources>
</Application>
