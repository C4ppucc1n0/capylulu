<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CapyLulu</AssemblyName>
    <RootNamespace>CapyLulu</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DefaultItemExcludes>$(DefaultItemExcludes);Resources\*.json</DefaultItemExcludes>
  </PropertyGroup>

  <!-- 发布版不带符号；Debug 版保留 pdb，崩溃时才有堆栈可看。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- OFL 1.1 中文像素字体。作为 WPF Resource 内嵌，单文件发布无需系统安装。 -->
    <Resource Include="Resources\Fonts\FusionPixel12pxProportionalSC.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- 动作图编译进单文件 EXE，不在运行时从外部文件夹读取。 -->
    <EmbeddedResource Include="..\..\generated_actions\*.webp">
      <LogicalName>CapyLulu.GeneratedActions.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\generated_actions\*.png">
      <LogicalName>CapyLulu.GeneratedActions.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\generated_actions\*.pet.json">
      <LogicalName>CapyLulu.GeneratedActions.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\gif_resources\*.gif">
      <LogicalName>CapyLulu.GifResources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\gif_resources\*.png">
      <LogicalName>CapyLulu.GifResources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\gif_resources\match-game\block\*.gif">
      <LogicalName>CapyLulu.GifResources.MatchGame.Block.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\gif_resources\match-game\celebrate\*.gif">
      <LogicalName>CapyLulu.GifResources.MatchGame.Celebrate.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Resource Remove="Resources\dialogues.zh-CN.json" />
    <EmbeddedResource Include="Resources\dialogues.zh-CN.json"
                      LogicalName="CapyLulu.Resources.dialogues.zh-CN.json">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>
</Project>
