<Window x:Class="CapyLulu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="CapyLulu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <Grid x:Name="_root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="_bubbleLayer"
              Grid.Row="0"
              Height="78"
              IsHitTestVisible="False">
            <Border x:Name="_bubble"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    MinWidth="150"
                    MaxWidth="270"
                    Background="White"
                    BorderBrush="#373737"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Visibility="Hidden">
                <TextBlock x:Name="_bubbleText"
                           Margin="16,9"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="Black"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>
            <Polygon x:Name="_bubbleTail"
                     Width="14"
                     Height="9"
                     Margin="0,0,0,-7"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Fill="White"
                     Points="0,0 14,0 7,9"
                     Stretch="Fill"
                     Stroke="#373737"
                     StrokeThickness="1.5"
                     Visibility="Hidden" />
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Image x:Name="_petImage"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Cursor="Hand"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,1"
                       SnapsToDevicePixels="True"
                       Stretch="Fill"
                       MouseLeftButtonDown="OnPetMouseLeftButtonDown"
                       MouseLeftButtonUp="OnPetMouseLeftButtonUp"
                       MouseMove="OnPetMouseMove"
                       MouseWheel="OnPetMouseWheel"
                       LostMouseCapture="OnPetLostMouseCapture">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="_moodScale" ScaleX="1" ScaleY="1" />
                            <ScaleTransform x:Name="_interactionScale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="_motionRotate" Angle="0" />
                            <TranslateTransform x:Name="_motionTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                    <Image.ContextMenu>
                        <ContextMenu x:Name="_petContextMenu"
                                     Closed="OnPetContextMenuClosed"
                                     FontFamily="Microsoft YaHei UI"
                                     FontSize="13"
                                     Opened="OnPetContextMenuOpened">
                            <MenuItem x:Name="_characterMenu" Header="更换角色" />
                            <MenuItem x:Name="_loafingMenu"
                                      Header="摸鱼模式"
                                      IsCheckable="True"
                                      Click="OnLoafingMenuClick" />
                            <MenuItem x:Name="_singingMenu" Header="唱歌" Click="OnSingingMenuClick" />
                            <MenuItem Header="音乐播放器" Click="OnMusicPlayerMenuClick" />
                            <MenuItem x:Name="_focusMenu"
                                      Header="专注模式：10 分钟"
                                      Click="OnFocusMenuClick" />
                            <MenuItem x:Name="_moodMenu" Header="当前状态" />
                            <MenuItem x:Name="_gazeModeMenu" />
                            <MenuItem x:Name="_topmostMenu"
                                      Header="始终置顶"
                                      IsCheckable="True"
                                      Click="OnTopmostMenuClick" />
                            <Separator />
                            <MenuItem Header="退出程序" Click="OnExitMenuClick" />
                        </ContextMenu>
                    </Image.ContextMenu>
                </Image>
                <Button x:Name="_singingSupportButton"
                        Width="44"
                        Height="44"
                        Margin="10,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="#F46991"
                        BorderBrush="#BB3760"
                        BorderThickness="1.5"
                        Content="♥"
                        Cursor="Hand"
                        FontFamily="Segoe UI Symbol"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="White"
                        ToolTip="给宠物应援"
                        Visibility="Collapsed"
                        Click="OnSingingSupportClick" />
            </StackPanel>
            <Grid x:Name="_singingEffectsLayer"
                  IsHitTestVisible="False"
                  ClipToBounds="True" />
        </Grid>

        <Border x:Name="_singingResponse"
                Grid.Row="2"
                Height="38"
                Margin="0,6,0,0"
                Padding="12,5"
                HorizontalAlignment="Center"
                Background="#E1FFE8F0"
                BorderBrush="#E27E9D"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False"
                MaxWidth="290"
                Visibility="Collapsed">
            <TextBlock x:Name="_singingResponseText"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#5D2A3E"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>

        <Border x:Name="_focusCountdown"
                Grid.Row="3"
                Margin="0,5,0,0"
                Padding="12,5"
                HorizontalAlignment="Center"
                Background="#BE232323"
                CornerRadius="12"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="_focusCountdownText"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextAlignment="Center" />
        </Border>
    </Grid>
</Window>
