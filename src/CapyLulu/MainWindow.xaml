<Window x:Class="CapyLulu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CapyLulu"
        x:ClassModifier="internal"
        Title="CapyLulu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{x:Static local:Skin.Font}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <Grid x:Name="_root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="_bubbleLayer"
              Grid.Row="0"
              Height="78"
              IsHitTestVisible="False">
            <Border x:Name="_bubble"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    MinWidth="150"
                    MaxWidth="270"
                    Padding="3"
                    Background="{x:Static local:Skin.WoodGrain}"
                    BorderBrush="{x:Static local:Skin.Outline}"
                    BorderThickness="2"
                    CornerRadius="12"
                    Visibility="Hidden">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="0"
                                      Color="#5A321A"
                                      Direction="315"
                                      Opacity="0.45"
                                      ShadowDepth="3" />
                </Border.Effect>
                <Border Background="{x:Static local:Skin.Paper}"
                        BorderBrush="{x:Static local:Skin.Highlight}"
                        BorderThickness="2,2,0,0"
                        CornerRadius="9">
                    <Border BorderBrush="{x:Static local:Skin.Shadow}"
                            BorderThickness="0,0,2,2"
                            CornerRadius="7">
                        <TextBlock x:Name="_bubbleText"
                                   Margin="16,9"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Static local:Skin.Ink}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>
                </Border>
            </Border>
            <Grid x:Name="_bubbleTail"
                     Width="18"
                     Height="12"
                     Margin="0,0,0,-7"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Visibility="Hidden">
                <Polygon Fill="{x:Static local:Skin.Outline}"
                         Points="0,0 18,0 9,12"
                         Stretch="Fill" />
                <Polygon Margin="3,0,3,3"
                         Fill="{x:Static local:Skin.Parchment}"
                         Points="0,0 12,0 6,8"
                         Stretch="Fill" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <StackPanel x:Name="_petRow"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Image x:Name="_petImage"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Cursor="Hand"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,1"
                       SnapsToDevicePixels="True"
                       Stretch="Fill"
                       MouseLeftButtonDown="OnPetMouseLeftButtonDown"
                       MouseLeftButtonUp="OnPetMouseLeftButtonUp"
                       MouseMove="OnPetMouseMove"
                       MouseWheel="OnPetMouseWheel"
                       LostMouseCapture="OnPetLostMouseCapture">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="_moodScale" ScaleX="1" ScaleY="1" />
                            <ScaleTransform x:Name="_interactionScale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="_motionRotate" Angle="0" />
                            <TranslateTransform x:Name="_motionTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                    <Image.ContextMenu>
                        <ContextMenu x:Name="_petContextMenu"
                                     Closed="OnPetContextMenuClosed"
                                     Opened="OnPetContextMenuOpened">
                            <MenuItem x:Name="_characterMenu" Header="更换角色" />
                            <MenuItem x:Name="_loafingMenu"
                                      Header="摸鱼模式"
                                      IsCheckable="True"
                                      Click="OnLoafingMenuClick" />
                            <Separator />
                            <MenuItem x:Name="_singingMenu" Header="唱歌" Click="OnSingingMenuClick" />
                            <MenuItem x:Name="_musicMenu" Header="音乐播放器" Click="OnMusicPlayerMenuClick" />
                            <MenuItem x:Name="_matchMenu" Header="消消乐" Click="OnMatchGameMenuClick" />
                            <Separator />
                            <MenuItem x:Name="_focusMenu"
                                      Header="专注模式：10 分钟"
                                      Click="OnFocusMenuClick" />
                            <MenuItem x:Name="_moodMenu" Header="当前状态" />
                            <MenuItem x:Name="_gazeModeMenu" />
                            <MenuItem x:Name="_topmostMenu"
                                      Header="始终置顶"
                                      IsCheckable="True"
                                      Click="OnTopmostMenuClick" />
                            <Separator />
                            <MenuItem x:Name="_exitMenu" Header="退出程序" Click="OnExitMenuClick" />
                        </ContextMenu>
                    </Image.ContextMenu>
                </Image>
                <!-- 应援按钮在 MainWindow 的构造函数里用 Skin.CreateButton 造，
                     这样它和两个窗口里的按钮是同一副斜面，按下去的手感也一致。 -->
            </StackPanel>
            <Grid x:Name="_singingEffectsLayer"
                  IsHitTestVisible="False"
                  ClipToBounds="True" />
        </Grid>

        <Border x:Name="_singingResponse"
                Grid.Row="2"
                Height="44"
                Margin="0,6,0,0"
                Padding="3"
                HorizontalAlignment="Center"
                Background="{x:Static local:Skin.WoodGrain}"
                BorderBrush="{x:Static local:Skin.Outline}"
                BorderThickness="2"
                CornerRadius="10"
                IsHitTestVisible="False"
                MaxWidth="290"
                Visibility="Collapsed">
            <Border Padding="10,4"
                    Background="{x:Static local:Skin.Paper}"
                    BorderBrush="{x:Static local:Skin.Highlight}"
                    BorderThickness="2,2,0,0"
                    CornerRadius="7">
                <TextBlock x:Name="_singingResponseText"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{x:Static local:Skin.Crimson}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>
        </Border>

        <Border x:Name="_focusCountdown"
                Grid.Row="3"
                Margin="0,5,0,0"
                Padding="3"
                HorizontalAlignment="Center"
                Background="{x:Static local:Skin.WoodGrain}"
                BorderBrush="{x:Static local:Skin.Outline}"
                BorderThickness="2"
                CornerRadius="10"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border Padding="12,5"
                    Background="{x:Static local:Skin.Field}"
                    BorderBrush="{x:Static local:Skin.Highlight}"
                    BorderThickness="2,2,0,0"
                    CornerRadius="7">
                <TextBlock x:Name="_focusCountdownText"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{x:Static local:Skin.Parchment}"
                           TextAlignment="Center" />
            </Border>
        </Border>
    </Grid>
</Window>
