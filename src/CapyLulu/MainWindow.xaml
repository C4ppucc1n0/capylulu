<Window x:Class="CapyLulu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CapyLulu"
        x:ClassModifier="internal"
        Title="CapyLulu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <Grid x:Name="_root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="_bubbleLayer"
              Grid.Row="0"
              Height="78"
              IsHitTestVisible="False">
            <Border x:Name="_bubble"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    MinWidth="150"
                    MaxWidth="270"
                    Background="{x:Static local:Skin.Parchment}"
                    BorderBrush="{x:Static local:Skin.Outline}"
                    BorderThickness="2"
                    CornerRadius="2"
                    Visibility="Hidden">
                <TextBlock x:Name="_bubbleText"
                           Margin="16,9"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{x:Static local:Skin.Ink}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>
            <Polygon x:Name="_bubbleTail"
                     Width="14"
                     Height="9"
                     Margin="0,0,0,-7"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Fill="{x:Static local:Skin.Parchment}"
                     Points="0,0 14,0 7,9"
                     Stretch="Fill"
                     Stroke="{x:Static local:Skin.Outline}"
                     StrokeThickness="2"
                     Visibility="Hidden" />
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <StackPanel x:Name="_petRow"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Image x:Name="_petImage"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Cursor="Hand"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,1"
                       SnapsToDevicePixels="True"
                       Stretch="Fill"
                       MouseLeftButtonDown="OnPetMouseLeftButtonDown"
                       MouseLeftButtonUp="OnPetMouseLeftButtonUp"
                       MouseMove="OnPetMouseMove"
                       MouseWheel="OnPetMouseWheel"
                       LostMouseCapture="OnPetLostMouseCapture">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="_moodScale" ScaleX="1" ScaleY="1" />
                            <ScaleTransform x:Name="_interactionScale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="_motionRotate" Angle="0" />
                            <TranslateTransform x:Name="_motionTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                    <Image.ContextMenu>
                        <ContextMenu x:Name="_petContextMenu"
                                     Closed="OnPetContextMenuClosed"
                                     FontFamily="Microsoft YaHei UI"
                                     FontSize="13"
                                     Opened="OnPetContextMenuOpened">
                            <MenuItem x:Name="_characterMenu" Header="更换角色" />
                            <MenuItem x:Name="_loafingMenu"
                                      Header="摸鱼模式"
                                      IsCheckable="True"
                                      Click="OnLoafingMenuClick" />
                            <MenuItem x:Name="_singingMenu" Header="唱歌" Click="OnSingingMenuClick" />
                            <MenuItem Header="音乐播放器" Click="OnMusicPlayerMenuClick" />
                            <MenuItem Header="消消乐" Click="OnMatchGameMenuClick" />
                            <MenuItem x:Name="_focusMenu"
                                      Header="专注模式：10 分钟"
                                      Click="OnFocusMenuClick" />
                            <MenuItem x:Name="_moodMenu" Header="当前状态" />
                            <MenuItem x:Name="_gazeModeMenu" />
                            <MenuItem x:Name="_topmostMenu"
                                      Header="始终置顶"
                                      IsCheckable="True"
                                      Click="OnTopmostMenuClick" />
                            <Separator />
                            <MenuItem Header="退出程序" Click="OnExitMenuClick" />
                        </ContextMenu>
                    </Image.ContextMenu>
                </Image>
                <!-- 应援按钮在 MainWindow 的构造函数里用 Skin.CreateButton 造，
                     这样它和两个窗口里的按钮是同一副斜面，按下去的手感也一致。 -->
            </StackPanel>
            <Grid x:Name="_singingEffectsLayer"
                  IsHitTestVisible="False"
                  ClipToBounds="True" />
        </Grid>

        <Border x:Name="_singingResponse"
                Grid.Row="2"
                Height="38"
                Margin="0,6,0,0"
                Padding="12,5"
                HorizontalAlignment="Center"
                Background="{x:Static local:Skin.Parchment}"
                BorderBrush="{x:Static local:Skin.Outline}"
                BorderThickness="2"
                CornerRadius="2"
                IsHitTestVisible="False"
                MaxWidth="290"
                Visibility="Collapsed">
            <TextBlock x:Name="_singingResponseText"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{x:Static local:Skin.Crimson}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>

        <Border x:Name="_focusCountdown"
                Grid.Row="3"
                Margin="0,5,0,0"
                Padding="12,5"
                HorizontalAlignment="Center"
                Background="{x:Static local:Skin.Field}"
                BorderBrush="{x:Static local:Skin.Outline}"
                BorderThickness="2"
                CornerRadius="2"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="_focusCountdownText"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{x:Static local:Skin.Parchment}"
                       TextAlignment="Center" />
        </Border>
    </Grid>
</Window>
